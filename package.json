{
  "name": "traceiq",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Repository Intelligence Platform. Know Your Codebase.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocapgaurav/TraceIQ.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck:tests": "tsc -b tsconfig.tests.json",
    "clean": "tsc -b --clean",
    "test": "vitest run && pnpm --filter @traceiq/web test",
    "test:watch": "vitest",
    "test:backend": "vitest run",
    "test:web": "pnpm --filter @traceiq/web test",
    "typecheck:web": "pnpm --filter @traceiq/web typecheck",
    "build:web": "pnpm --filter @traceiq/web build"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
